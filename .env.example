# ==============================================================================
# VOUCHIQO PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace placeholder values with your production secrets.
# IMPORTANT: NEVER commit the actual .env file or sensitive keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION ENVIRONMENT & URLS
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://vouchiqo.com
PORT=3000

# ------------------------------------------------------------------------------
# DATABASE & CACHING INFRASTRUCTURE
# ------------------------------------------------------------------------------
# MongoDB connection URI (production replica set with authentication)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_domain>/vouchiqo?retryWrites=true&w=majority&appName=VouchiqoProd

# Redis URL for session caching, rate limiting, and BullMQ background workers
REDIS_URL=rediss://default:<redis_password>@<redis_host>:6379

# ------------------------------------------------------------------------------
# BETTER AUTHENTICATION
# ------------------------------------------------------------------------------
# Root URL for auth callbacks & session validation
BETTER_AUTH_URL=https://vouchiqo.com
# High-entropy secret key (min 32 characters, e.g. generated via openssl rand -base64 32)
BETTER_AUTH_SECRET=your_high_entropy_32_char_secret_value_here_random

# ------------------------------------------------------------------------------
# GOOGLE OAUTH & ONE TAP
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# ADMIN PORTAL CREDENTIALS
# ------------------------------------------------------------------------------
# Admin portal username (maps to <ADMIN_USERNAME>@vouchiqo.com)
ADMIN_USERNAME=admin
# Strong administrator password (minimum 12 characters, mix of uppercase, symbols & numbers)
ADMIN_PASSWORD=YourStrongProductionAdminPassword123!

# ------------------------------------------------------------------------------
# SEED & MAINTENANCE SECURITY
# ------------------------------------------------------------------------------
# Secret token required to run database seeding (Disabled in production)
SEED_SECRET=your_seed_maintenance_secret_key_here

# ------------------------------------------------------------------------------
# CLOUDINARY MEDIA ASSETS
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Vouchiqo <noreply@vouchiqo.com>"
EMAIL_FROM_MERCHANT="Vouchiqo Merchant <merchant@vouchiqo.com>"
EMAIL_DEV_RECIPIENT=vouchiqo@gmail.com

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (RAZORPAY)
# ------------------------------------------------------------------------------
# Razorpay Key ID (rzp_test_... for staging, rzp_live_... for production)
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
# Razorpay Key Secret (Server-side ONLY - Never expose to client bundles)
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# Razorpay Webhook Signing Secret (Used to verify webhook payloads)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# FIREBASE WEB PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
# Client-side configuration (served dynamically via /api/push/sw)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vouchiqo-webitya.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vouchiqo-webitya
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vouchiqo-webitya.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# Firebase Admin SDK (Server-side ONLY)
FIREBASE_PROJECT_ID=vouchiqo-webitya
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@vouchiqo-webitya.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# OPTIONAL: INITIAL MERCHANT SEEDING (scripts/create-merchant.js)
# ------------------------------------------------------------------------------
INITIAL_MERCHANT_EMAIL=merchant@vouchiqo.com
INITIAL_MERCHANT_PASSWORD=ChangeThisPasswordUponDeployment123!
INITIAL_MERCHANT_NAME="Vouchiqo Prime Store"
